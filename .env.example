# Copy to .env and fill in. Never commit .env or the .pem.

PORT=8787
# This service's public HTTPS origin (a tunnel when local): Photon redirects
# admins to $PUBLIC_BASE_URL/callback and sends webhooks under it.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Photon staging
PHOTON_API_ORIGIN=https://api.staging.photon.codes
PHOTON_DASHBOARD_ORIGIN=https://app.staging.photon.codes
# Unconfirmed: where the App's M2M credential is exchanged for a token (see README).
PHOTON_TOKEN_URL=https://valuable-sunset-13-staging.authkit.app/oauth2/token
PHOTON_WEBHOOK_API_VERSION=2026-07-01

# The App, as registered in Photon's Developer → Apps (pnpm keygen makes the key)
PHOTON_APP_ID=pho_app_...
PHOTON_APP_KEY_ID=supermemory-2026-10-17
PHOTON_APP_KEY_ALG=ES256
PHOTON_APP_PRIVATE_KEY_PATH=./supermemory-2026-10-17.pem

# manual: webhook destinations made by hand, listed below (works today)
# app:    the App creates them itself (Photon refuses this today, ENG-4010)
PROVISIONER=manual
# key (the last path segment of the webhook URL you gave Photon) → where it's from and its secret:
# webhook URL = $PUBLIC_BASE_URL/webhooks/photon/<key>
MANUAL_DESTINATIONS={"test-project-1": {"organizationId": "pho_org_...", "projectId": "pho_prj_...", "secret": "whsec_..."}}

# Supermemory
SUPERMEMORY_API_ORIGIN=https://api.supermemory.ai
SUPERMEMORY_API_KEY=

# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=

DATABASE_PATH=data/supermemory-app.db
