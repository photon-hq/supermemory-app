# Copy to .env and fill in. Never commit .env or the .pem.

PORT=8787
# This service's public HTTPS origin (a tunnel when local). Register in
# Photon's Developer → Apps:
#   HTTPS callback:    $PUBLIC_BASE_URL/callback
#   Event webhook URL: $PUBLIC_BASE_URL/webhooks/photon
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Photon staging. All three must be the same environment's.
PHOTON_API_ORIGIN=https://api.staging.photon.codes
PHOTON_DASHBOARD_ORIGIN=https://app.staging.photon.codes
# The environment's AuthKit token endpoint, as Photon supplies it (staging's, confirmed).
PHOTON_TOKEN_URL=https://valuable-sunset-13-staging.authkit.app/oauth2/token

# The App, as registered in Photon's Developer → Apps (pnpm keygen makes the key)
PHOTON_APP_ID=pho_app_...
PHOTON_APP_KEY_ID=supermemory-2026-10-17
PHOTON_APP_KEY_ALG=ES256
PHOTON_APP_PRIVATE_KEY_PATH=./supermemory-2026-10-17.pem

# The App's webhook signing secret: "Generate and reveal secret" on its
# Developer → Apps page. Shown once; one per App, for all its installations.
PHOTON_WEBHOOK_SECRET=whsec_...

# Supermemory
SUPERMEMORY_API_ORIGIN=https://api.supermemory.ai
SUPERMEMORY_API_KEY=

# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=

DATABASE_PATH=data/supermemory-app.db
